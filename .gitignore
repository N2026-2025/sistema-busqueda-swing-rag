# .gitignore para Java/Maven/Eclipse/VSCode

# Archivos de clase compilados
target/
*.class

# Archivos de IDE
.idea/
*.iws
*.iml
.vscode/

# Archivos del sistema
.DS_Store
*.swp
*.swo

# Archivos de caché de Maven
**/.m2/
/*.cache

# Archivos de la aplicación (solo generados en runtime)
*.csv (generados por la app, no el fuente)

# Logs
*.log